#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

&mt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        middle-click {
            bindings = <&mkp MB3>;
            key-positions = <40 41>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        delete1 {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        delete2 {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 7>;
        };

        forward_delete1 {
            bindings = <&kp DELETE>;
            key-positions = <8 9 30>;
        };

        forward_delete2 {
            bindings = <&kp DELETE>;
            key-positions = <8 30 7>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        encoder_msc_left_right: encoder_msc_left_right {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_LEFT_RIGHT";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&lt 2 Q           &kp W      &kp E         &kp R              &kp T        &kp Y      &kp U             &kp I            &kp O              &kp P
&lt 3 A           &kp S      &kp D         &kp F              &kp G        &kp H      &kp J             &kp K            &kp L              &kp ENTER
&mt LEFT_SHIFT Z  &kp X      &kp C         &kp V              &lt 4 B      &kp N      &kp M             &kp COMMA        &kp PERIOD         &kp MINUS
&kp LEFT_SHIFT    &kp LCTRL  &kp LEFT_ALT  &mt LEFT_META TAB  &lt 1 SPACE  &lt 1 ESC  &lt 2 RIGHT_META  &lt 3 RIGHT_ALT  &kp RIGHT_CONTROL  &kp RIGHT_SHIFT
&mkp MB1          &mkp MB2
            >;

            sensor-bindings = <&encoder_msc_down_up>, <&encoder_msc_left_right>;
        };

        number_symbol {
            bindings = <
&kp NUMBER_1    &kp N2  &kp N3    &kp N4   &kp N5     &kp N6     &kp N7     &kp N8     &kp N9    &kp N0
&kp GRAVE       &none   &none     &none    &none      &kp BSLH   &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT
&kp LEFT_SHIFT  &none   &kp FSLH  &kp DOT  &kp COMMA  &kp COMMA  &kp DOT    &kp FSLH   &kp SEMI  &kp APOS
&kp LSHFT       &trans  &trans    &trans   &trans     &trans     &trans     &trans     &trans    &trans
&trans          &trans
            >;
        };

        move {
            bindings = <
&mo 2           &kp LA(LEFT_ARROW)  &kp UP_ARROW    &kp LA(RIGHT_ARROW)  &none   &kp HOME            &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &kp RSHFT
&kp LEFT_SHIFT  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &none   &kp LEFT_ARROW      &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp RSHFT
&kp LEFT_SHIFT  &none               &none           &none                &none   &kp LA(LEFT_ARROW)  &none           &none         &kp RA(RIGHT)    &kp RSHFT
&trans          &trans              &trans          &trans               &trans  &trans              &mo 2           &trans        &trans           &trans
&mkp MB1        &mkp MB2
            >;

            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        function {
            bindings = <
&kp F1          &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10
&none           &none   &none   &none   &none   &none   &none   &none   &kp F11  &kp F12
&kp LEFT_SHIFT  &none   &none   &none   &none   &none   &none   &none   &none    &none
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans          &trans
            >;
        };

        bluetooth {
            bindings = <
&bt BT_CLR_ALL  &bt BT_CLR    &none         &none         &none         &none        &none  &none  &none  &none
&none           &none         &none         &none         &none         &none        &none  &none  &none  &none
&none           &none         &none         &none         &none         &none        &none  &none  &none  &none
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bootloader  &none  &none  &none  &none
&trans          &trans
            >;
        };
    };
};
