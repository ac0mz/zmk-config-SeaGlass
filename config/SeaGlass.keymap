#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

&mt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        middle-click {
            bindings = <&mkp MB3>;
            key-positions = <40 41>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        delete {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 7>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        kakko: kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "KAKKO";
        };

        dai_kakkko: daikakkko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;
            label = "DAIKAKKKO";
        };

        nami_kakko: nami_kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT_ARROW>;
            label = "NAMI_KAKKO";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        encoder_msc_left_right: encoder_msc_left_right {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_LEFT_RIGHT";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&lt 3 Q                    &kp W      &kp E         &kp R              &kp T        &kp Y      &kp U             &kp I            &kp O              &kp P
&lt 2 A                    &kp S      &kp D         &kp F              &kp G        &kp H      &kp J             &kp K            &kp L              &kp ENTER
&mt LEFT_SHIFT Z           &kp X      &kp C         &kp V              &lt 4 B      &kp N      &kp M             &kp COMMA        &kp PERIOD         &kp MINUS
&mt LEFT_SHIFT LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &mt LEFT_META TAB  &lt 1 SPACE  &lt 1 ESC  &lt 2 RIGHT_META  &lt 3 RIGHT_ALT  &kp RIGHT_CONTROL  &mt RIGHT_SHIFT RIGHT_SHIFT
&mkp MB1                   &mkp MB2
            >;

            sensor-bindings = <&encoder_msc_down_up>, <&encoder_msc_left_right>;
        };

        number_symbol {
            bindings = <
&kp NUMBER_1    &kp N2  &kp N3    &kp N4   &kp N5     &kp N6     &kp N7     &kp N8     &kp N9    &kp N0
&kp GRAVE       &none   &none     &none    &none      &kp BSLH   &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT
&kp LEFT_SHIFT  &none   &kp FSLH  &kp DOT  &kp COMMA  &kp COMMA  &kp DOT    &kp FSLH   &kp SEMI  &kp APOS
&kp LSHFT       &trans  &trans    &trans   &trans     &trans     &trans     &trans     &trans    &trans
&trans          &trans
            >;
        };

        function {
            bindings = <
&kp F1          &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10
&none           &none   &none   &none   &none   &none   &none   &none   &kp F11  &kp F12
&kp LEFT_SHIFT  &none   &none   &none   &none   &none   &none   &none   &none    &none
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans          &trans
            >;
        };

        move {
            bindings = <
&none                       &mkp MB4                &kp LG(LA(UP_ARROW))  &mkp MB5                 &none                        &kp LG(LEFT_ARROW)  &kp LA(LEFT_ARROW)  &kp UP_ARROW    &kp RA(RIGHT_ARROW)  &kp RG(RIGHT_ARROW)
&kp LA(LG(LC(LEFT_ARROW)))  &kp LA(LG(LEFT_ARROW))  &kp LA(LG(F))         &kp RG(RA(RIGHT_ARROW))  &kp RA(RC(RG(RIGHT_ARROW)))  &kp LC(LS(TAB))     &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp RC(TAB)
&none                       &kp LG(LS(LEFT_ARROW))  &kp LG(LA(DOWN))      &kp LG(LS(RIGHT_ARROW))  &none                        &none               &none               &none           &none                &none
&trans                      &trans                  &trans                &trans                   &trans                       &trans              &trans              &trans          &trans               &trans
&mkp MB1                    &mkp MB2
            >;

            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        bluetooth {
            bindings = <
&bt BT_CLR_ALL  &bt BT_CLR    &none         &none         &none         &none        &none  &none  &none  &none
&none           &none         &none         &none         &none         &none        &none  &none  &none  &none
&none           &none         &none         &none         &none         &none        &none  &none  &none  &none
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bootloader  &none  &none  &none  &none
&trans          &trans
            >;
        };
    };
};
